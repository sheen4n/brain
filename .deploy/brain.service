[Unit]
Description=Brain agent (Claude Code + Telegram channel)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=agent
WorkingDirectory=/home/agent/brain
Environment=HOME=/home/agent
Environment=TERM=xterm-256color
Environment=PATH=/home/agent/.local/bin:/home/agent/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux new-session -d -s brain '/home/agent/.local/bin/claude --channels plugin:telegram@claude-plugins-official'
ExecStop=/usr/bin/tmux kill-session -t brain
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
